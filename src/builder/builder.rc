#include <winver.h>
#include "../common/version.h"
#include "builderres.h"
// Путь к собранному setup.exe задаёт файл setup_stub_path.h, создаваемый CMake.
#include "setup_stub_path.h"

#pragma code_page(65001)

1 ICON "builder.ico"

IDR_SETUP_STUB RCDATA XPSETUP_SETUP_STUB

VS_VERSION_INFO VERSIONINFO
 FILEVERSION XPSETUP_VERSION_MAJOR, XPSETUP_VERSION_MINOR, 0, 0
 PRODUCTVERSION XPSETUP_VERSION_MAJOR, XPSETUP_VERSION_MINOR, 0, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "roosslan"
            VALUE "FileDescription", "Сборщик дистрибутивов XPSetup"
            VALUE "FileVersion", XPSETUP_VERSION
            VALUE "InternalName", "xpsbuild"
            VALUE "LegalCopyright", XPSETUP_COPYRIGHT
            VALUE "OriginalFilename", "xpsbuild.exe"
            VALUE "ProductName", "XPSetup"
            VALUE "ProductVersion", XPSETUP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
